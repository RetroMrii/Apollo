<Window x:Class="Apollo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apollo"
        Width="720"
        Height="760"
        MinWidth="620"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource ApplicationFont}"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,26,32,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock FontSize="23"
                               FontWeight="SemiBold"
                               Text="Apollo" />
                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource SecondaryTextStyle}"
                               Text="Recorder automation for your games" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <TextBlock Margin="0,0,10,0"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Text="Monitoring" />
                        <ToggleButton IsChecked="{Binding IsMonitoringEnabled}"
                                      Command="{Binding ToggleMonitoringCommand}"
                                      IsEnabled="{Binding IsMonitoringAvailable}"
                                      Style="{StaticResource SwitchToggleStyle}"
                                      ToolTip="Detect configured games in the background." />
                    </StackPanel>
                    <TextBlock Margin="0,5,0,0"
                               HorizontalAlignment="Right"
                               Style="{StaticResource MutedTextStyle}"
                               Text="{Binding MonitoringStatusText}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1"
                  Margin="0,30,0,10">
                <TextBlock Style="{StaticResource SectionHeadingStyle}"
                           Text="Recorder" />
            </Grid>

            <Grid Grid.Row="2">
                <Border x:Name="RecorderEmptyState"
                        Style="{StaticResource CardStyle}"
                        Visibility="{Binding HasRecorder, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="42"
                                Height="42"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="{StaticResource SubtleSurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="16"
                                       Text="●" />
                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="4,0,24,0"
                                    VerticalAlignment="Center">
                            <TextBlock FontSize="14"
                                       FontWeight="SemiBold"
                                       Text="No recorder configured" />
                            <TextBlock Margin="0,5,0,0"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Text="Choose the recording application Apollo should manage."
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Button Grid.Column="2"
                                MinWidth="126"
                                VerticalAlignment="Center"
                                Command="{Binding ChooseRecorderCommand}"
                                Content="Choose recorder"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>
                </Border>

                <Border x:Name="RecorderCard"
                        Style="{StaticResource CardStyle}"
                        Visibility="{Binding HasRecorder, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="42"
                                Height="42"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="{StaticResource SubtleSurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9">
                            <Grid>
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Text="R" />
                                <Image Width="26"
                                       Height="26"
                                       Source="{Binding RecorderIcon}"
                                       Stretch="Uniform" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1"
                                    Margin="4,0,24,0"
                                    VerticalAlignment="Center">
                            <TextBlock FontSize="14"
                                       FontWeight="SemiBold"
                                       Text="{Binding RecorderDisplayName}" />
                            <TextBlock Margin="0,5,0,0"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Text="{Binding RecorderProcessName}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Center">
                            <TextBlock Margin="0,0,0,7"
                                       HorizontalAlignment="Right"
                                       Style="{StaticResource MutedTextStyle}"
                                       Text="{Binding RecorderStatusText}" />
                            <Button MinWidth="78"
                                    Command="{Binding ChooseRecorderCommand}"
                                    Content="Change"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>

            <Grid Grid.Row="3"
                  Margin="0,27,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           Style="{StaticResource SectionHeadingStyle}"
                           Text="Games" />
                <Button Grid.Column="1"
                        Command="{Binding AddGameCommand}"
                        Content="+  Add game"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </Grid>

            <Grid Grid.Row="4">
                <Border x:Name="GamesEmptyState"
                        Padding="24,22"
                        Style="{StaticResource CardStyle}"
                        Visibility="{Binding HasGames, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Text="No games added" />
                        <TextBlock MaxWidth="390"
                                   Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Text="Add a game and Apollo will launch your recorder automatically when that game starts."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <ItemsControl x:Name="GamesList"
                              ItemsSource="{Binding Games}"
                              Visibility="{Binding HasGames, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8"
                                    Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="42"
                                            Height="42"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource SubtleSurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="9">
                                        <Grid>
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       Text="G" />
                                            <Image Width="26"
                                                   Height="26"
                                                   Source="{Binding Icon}"
                                                   Stretch="Uniform" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1"
                                                Margin="4,0,20,0"
                                                VerticalAlignment="Center">
                                        <TextBlock FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding DisplayName}" />
                                        <StackPanel Margin="0,5,0,0"
                                                    Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource SecondaryTextStyle}"
                                                       Text="{Binding DisplayProcessName}" />
                                            <TextBlock Foreground="{StaticResource AccentHoverBrush}"
                                                       Style="{StaticResource SecondaryTextStyle}"
                                                       Text=" · Running"
                                                       Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2"
                                                VerticalAlignment="Center">
                                        <ToggleButton HorizontalAlignment="Right"
                                                      Command="{Binding DataContext.SaveSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                      IsEnabled="{Binding DataContext.IsConfigurationAvailable, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      Style="{StaticResource SwitchToggleStyle}" />
                                        <Button Margin="0,7,0,0"
                                                Padding="10,0"
                                                Command="{Binding DataContext.RemoveGameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Content="Remove"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </Grid>

            <StackPanel Grid.Row="5"
                        Margin="0,27,0,0">
                <TextBlock Margin="0,0,0,10"
                           Style="{StaticResource SectionHeadingStyle}"
                           Text="Behavior" />

                <Border Padding="20,5"
                        Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid Style="{StaticResource SettingRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SettingLabelStyle}"
                                           Text="Launch recorder with monitored games" />
                                <TextBlock Margin="0,3,24,0"
                                           Style="{StaticResource MutedTextStyle}"
                                           Text="Starts the configured recorder when a game appears." />
                            </StackPanel>
                            <ToggleButton Grid.Column="1"
                                          Command="{Binding SaveSettingsCommand}"
                                          IsChecked="{Binding LaunchRecorderWithGames}"
                                          IsEnabled="{Binding IsBehaviorAvailable}"
                                          Style="{StaticResource SwitchToggleStyle}" />
                        </Grid>

                        <Border Height="1"
                                Background="{StaticResource DividerBrush}" />

                        <Grid Style="{StaticResource SettingRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SettingLabelStyle}"
                                           Text="Close recorder when games exit" />
                                <TextBlock Margin="0,3,24,0"
                                           Style="{StaticResource MutedTextStyle}"
                                           Text="Stops the recorder after the final monitored game closes." />
                            </StackPanel>
                            <ToggleButton Grid.Column="1"
                                          Command="{Binding SaveSettingsCommand}"
                                          IsChecked="{Binding CloseRecorderWhenGamesExit}"
                                          IsEnabled="{Binding IsBehaviorAvailable}"
                                          Style="{StaticResource SwitchToggleStyle}" />
                        </Grid>

                        <Border Height="1"
                                Background="{StaticResource DividerBrush}" />

                        <Grid Style="{StaticResource SettingRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SettingLabelStyle}"
                                           Text="Start Apollo with Windows" />
                                <TextBlock Margin="0,3,24,0"
                                           Style="{StaticResource MutedTextStyle}"
                                           Text="Opens Apollo automatically after sign-in." />
                            </StackPanel>
                            <ToggleButton Grid.Column="1"
                                          Command="{Binding SaveStartupSettingCommand}"
                                          IsChecked="{Binding StartWithWindows}"
                                          IsEnabled="{Binding IsStartupAvailable}"
                                          Style="{StaticResource SwitchToggleStyle}" />
                        </Grid>

                        <Border Height="1"
                                Background="{StaticResource DividerBrush}" />

                        <Grid Style="{StaticResource SettingRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SettingLabelStyle}"
                                           Text="Start minimized" />
                                <TextBlock Margin="0,3,24,0"
                                           Style="{StaticResource MutedTextStyle}"
                                           Text="Keeps the main window hidden at startup." />
                            </StackPanel>
                            <ToggleButton Grid.Column="1"
                                          Command="{Binding SaveSettingsCommand}"
                                          IsChecked="{Binding StartMinimized}"
                                          IsEnabled="{Binding IsStartMinimizedAvailable}"
                                          Style="{StaticResource SwitchToggleStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Margin="2,12,0,0"
                           Style="{StaticResource MutedTextStyle}"
                           Text="Closing this window keeps Apollo running in the notification area." />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
