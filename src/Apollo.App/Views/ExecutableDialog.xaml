<Window x:Class="Apollo.Views.ExecutableDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configure executable"
        Width="600"
        Height="540"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource ApplicationFont}"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeadingTextBlock"
                   FontSize="19"
                   FontWeight="SemiBold" />

        <StackPanel x:Name="ModeSelector"
                    Grid.Row="1"
                    Margin="0,20,0,0"
                    Orientation="Horizontal"
                    Visibility="Collapsed">
            <RadioButton x:Name="BrowseModeButton"
                         Checked="BrowseModeButton_Checked"
                         Content="Browse executable"
                         GroupName="ExecutableMode"
                         IsChecked="True"
                         Style="{StaticResource ModeTabStyle}" />
            <RadioButton x:Name="RunningModeButton"
                         Margin="6,0,0,0"
                         Checked="RunningModeButton_Checked"
                         Content="Running applications"
                         GroupName="ExecutableMode"
                         Style="{StaticResource ModeTabStyle}" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <StackPanel x:Name="BrowsePanel">
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Executable" />
                <Grid Margin="0,7,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PathTextBox"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxStyle}" />
                    <Button Grid.Column="1"
                            Margin="8,0,0,0"
                            Click="BrowseButton_Click"
                            Content="Browse…"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </Grid>

                <TextBlock Margin="0,17,0,0"
                           Style="{StaticResource FieldLabelStyle}"
                           Text="Display name" />
                <TextBox x:Name="DisplayNameTextBox"
                         Margin="0,7,0,0"
                         MaxLength="120"
                         Style="{StaticResource TextBoxStyle}" />

                <TextBlock Margin="0,17,0,0"
                           Style="{StaticResource FieldLabelStyle}"
                           Text="Process name" />
                <TextBox x:Name="ProcessNameTextBox"
                         Margin="0,7,0,0"
                         MaxLength="260"
                         Style="{StaticResource TextBoxStyle}" />
            </StackPanel>

            <Grid x:Name="RunningPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource SecondaryTextStyle}"
                               Text="Select an application that is currently open." />
                    <Button Grid.Column="1"
                            Padding="11,0"
                            Click="RefreshRunningApplicationsButton_Click"
                            Content="Refresh"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <ListBox x:Name="RunningApplicationsListBox"
                             Background="Transparent"
                             BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ItemContainerStyle="{StaticResource RunningApplicationItemStyle}"
                             MouseDoubleClick="RunningApplicationsListBox_MouseDoubleClick"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="RunningApplicationsListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34"
                                            Height="34"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource SubtleSurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="7">
                                        <Grid>
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="11"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       Text="APP" />
                                            <Image Width="22"
                                                   Height="22"
                                                   Source="{Binding Icon}"
                                                   Stretch="Uniform" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding DisplayName}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,3,0,0"
                                                   Style="{StaticResource SecondaryTextStyle}"
                                                   Text="{Binding DisplayProcessName}" />
                                        <TextBlock Margin="0,2,0,0"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   Text="{Binding DisplayPath}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding DisplayPath}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel x:Name="RunningStatusPanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="RunningStatusTextBlock"
                                   MaxWidth="360"
                                   TextAlignment="Center"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Text="Loading running applications…"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <TextBlock x:Name="ValidationTextBlock"
                   Grid.Row="3"
                   Margin="0,10,0,0"
                   Foreground="#E39A9A"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />

        <StackPanel Grid.Row="4"
                    Margin="0,18,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button MinWidth="82"
                    Click="CancelButton_Click"
                    Content="Cancel"
                    IsCancel="True"
                    Style="{StaticResource SecondaryButtonStyle}" />
            <Button x:Name="SaveButton"
                    MinWidth="82"
                    Margin="8,0,0,0"
                    Click="SaveButton_Click"
                    Content="Save"
                    IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
